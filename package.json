{
  "name": "image-gallery-approval",
  "version": "1.0.0",
  "description": "Image Gallery with Approval Workflow",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": ["image", "gallery", "approval", "workflow"],
  "author": "WebWizrd",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
